# Quvanta — copy to .env.local for local dev, or set these in
# Vercel Dashboard > Project > Settings > Environment Variables.
# Never commit a real .env file or real keys to Git.

# PostgreSQL connection string (Neon free tier recommended — see README.md).
# Neon gives a pooled URL; use the pooled one for serverless.
DATABASE_URL="postgresql://user:password@ep-xxxx-xxxx-pooler.us-east-2.aws.neon.tech/quvanta?sslmode=require"

# Long random secret used to sign session cookies. Generate with:
#   openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# Sports data API keys (optional — without them the sportsbook, IPL and
# World Cup pages show clearly-labelled DEMO fixtures; never fake live data).
# Get them on your own account: https://cricketdata.org and https://the-odds-api.com
CRICAPI_KEY=""
ODDS_API_KEY=""

# Platform payment addresses shown to players in the Wallet.
# Set real values in the operator Settings page after first deploy.
UPI_ID="quvanta@upi"
USDT_ADDRESS=""

# Optional seed overrides (only used by `prisma db seed` on a fresh DB).
# If left empty, the seed uses the documented initial operator login
# (see OWNER-SETUP.md) and the placeholder payment addresses above.
SEED_ADMIN_EMAIL="admin@quvanta.gg"
